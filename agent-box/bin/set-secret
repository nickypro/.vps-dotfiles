#!/bin/bash
# Store an API key where agents find it. The value comes from stdin, so it
# never shows up in a process list or your shell history. Runs as root;
# `make secret KEY=...` on the host prompts for the value and calls this.
#   set-secret KEY          -> /home/dev/.env: agents T3 starts as you (then
#                              make t3-restart) and your shells
#   set-secret KEY <cell>   -> that isolated agent's own ~/.env only (picked up
#                              by its next session)
set -euo pipefail
key=${1:?usage: set-secret KEY [cell] <<< value}
cell=${2-}
[[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "set-secret: not a variable name: $key" >&2; exit 64; }
[ "$(id -u)" = 0 ] || { echo "set-secret: run as root" >&2; exit 64; }
IFS= read -r val || true
[ -n "$val" ] || { echo "set-secret: empty value, nothing changed" >&2; exit 1; }
if [ -n "$cell" ]; then
  . /opt/agent-box/cells/lib.sh
  cell_exists "$cell" || { echo "set-secret: no cell called '$cell'" >&2; exit 64; }
  f=$CELLS/$cell/home/.env owner=cell-$cell
else
  f=/home/dev/.env owner=dev
fi
touch "$f"
# Single quotes, so the value is taken literally when the file is sourced.
q=${val//\'/\'\\\'\'}
tmp=$(mktemp "$f.XXXXXX")
grep -v "^$key=" "$f" >"$tmp" || true
printf "%s='%s'\n" "$key" "$q" >>"$tmp"
chown "$owner:$owner" "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$f"
echo "  $key saved in $f"
