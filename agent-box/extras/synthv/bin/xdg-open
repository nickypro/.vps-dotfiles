#!/bin/bash
# Debian 12's xdg-open (xdg-utils 1.1.3) treats a URL scheme containing a digit
# as a file path, so Chromium's hand-off of "dreamtonics-svstudio2://auth/..."
# fails with "file ... does not exist" and the app never sees the log-in.
# env.sh puts this folder first on PATH: that scheme goes straight to the app,
# everything else to the real xdg-open.
case "${1:-}" in
  dreamtonics-svstudio2:*) exec "$(dirname "$(readlink -f "$0")")/../synthv" "$1" ;;
esac
exec /usr/bin/xdg-open "$@"
