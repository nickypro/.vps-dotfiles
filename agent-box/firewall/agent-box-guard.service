[Unit]
Description=Firewall the agent-box container off the host and internal networks
After=docker.service
Wants=docker.service

[Service]
# Applies the rules, then re-applies them every time the container starts.
# No ExecStop on purpose: if this service dies or restarts, the rules stay in
# place rather than lifting for a moment. `make guard-off` removes them.
ExecStart=/usr/local/sbin/agent-box-guard watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
